# ==============================================================================
# AMETHEUS Esports Platform — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local Next.js development.
# ==============================================================================

# ==========================================
# BACKEND API URL
# ==========================================
# Base URL of the FastAPI backend service
NEXT_PUBLIC_API_URL=http://localhost:8000
# For production deployment:
# NEXT_PUBLIC_API_URL=https://ametheus-backend.onrender.com

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
# Publishable Key (from Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ametheus_clerk_placeholder
# Secret Key (Server-side proxy/middleware only)
CLERK_SECRET_KEY=sk_test_ametheus_clerk_secret_placeholder

# ==========================================
# PUBLIC SUPPORT CONTACT (Fallback)
# ==========================================
# Note: Official, Support, and Automated emails are dynamically fetched from the
# backend database via the Super Admin Email Settings panel.
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
