# ===================================================================
# AMETHEUS FRONTEND — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===================================================================

# ---- Backend API -----------------------------------------------
# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# ---- Clerk Authentication --------------------------------------
# Publishable key from https://dashboard.clerk.com → API Keys
# Format: pk_test_... (development) or pk_live_... (production)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# NOTE: The Clerk SECRET KEY must NEVER be exposed here.
# It belongs only in the backend .env (CLERK_SECRET_KEY).
#
# All routing is now application-hosted under /sign-in and /sign-up:
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# For production:
#   1. Replace pk_test_... with pk_live_...
#   2. In Clerk Dashboard → Configure → Paths, set:
#      Sign-in path: /sign-in
#      Sign-up path: /sign-up
#   3. Set VITE_API_URL to your production backend URL
